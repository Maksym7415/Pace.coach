# App environment: development | production (controls strict env checks, CORS, debug server)
APP_ENV=development

# Database (PostgreSQL)
# Local dev: use DB_* vars (synced with docker-compose.yml)
# Production (Supabase): set DATABASE_URL with full URI instead
DB_USER=shoe_tracker
DB_PASSWORD=shoe_tracker
DB_NAME=shoe_tracker
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=168
# Optional audience claim for new tokens (default shoe-tracker-api)
# JWT_AUDIENCE=shoe-tracker-api

# Strava OAuth (empty client id/secret = Strava features disabled in dev)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://your-backend.example.com/api/strava/callback
STRAVA_SCOPE=activity:read_all,activity:write
# Optional: where GET /api/strava/callback redirects after token exchange.
# React Native: omit to use default shoe-tracker://strava/callback, or pass redirect_uri on /api/strava/connect.
# Web (Vite): set e.g. http://localhost:5173/strava/oauth
# STRAVA_FRONTEND_REDIRECT_URL=http://localhost:5173/strava/oauth
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-verify-token
# Required when APP_ENV=production (OAuth callbacks, webhook subscription tooling)
BACKEND_URL=https://your-backend.example.com

# Optional: encrypt Strava tokens at rest (Fernet key). Recommended in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Browser CORS for /api/* (production should set your web app origin; dev allows localhost + Vite)
# FRONTEND_WEB_ORIGIN=http://localhost:5173

# Optional: log level DEBUG|INFO|WARNING|ERROR
# LOG_LEVEL=INFO

# Local FIT file storage (dev only; default backend/storage/)
# ACTIVITY_STORAGE_PATH=

# Optional: webhook callback path (default /api/webhooks/strava)
# STRAVA_WEBHOOK_CALLBACK_PATH=/api/webhooks/strava
